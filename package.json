{
  "name": "jevpromptcoach",
  "version": "0.3.0",
  "description": "Scores how well you prompt a coding agent, and shows your habits improving over time. Runs on TypeSafe Jev.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CrowdLinker/JevPromptCoach.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "check-leaks": "node scripts/check-leaks.mjs",
    "test": "npm run build && npm run lint && npm run test:unit && npm run check-leaks",
    "eval": "npm run build && node dist/eval.js",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "test:unit": "node --test test/*.test.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.1",
    "@typesafe-ai/sdk": "0.6.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "files": [
    "dist",
    "commands",
    "hooks",
    ".claude-plugin",
    "docs",
    "assets",
    "README.md",
    "README.fr.md",
    "README.es.md",
    "TRADEMARKS.md",
    "LICENSE"
  ]
}
